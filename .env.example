# Copy this file to .env in the project root and adjust. The API and `npm run n` read it from there.

PORT=4000

# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/jackal
# MongoDB Atlas (free tier) looks like:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/jackal?retryWrites=true&w=majority

# Origin allowed to call the API from a browser (the Vite dev server).
CLIENT_ORIGIN=http://localhost:5173

# Which address the API listens on. Keep 127.0.0.1 so only this computer can reach it.
# HOST=127.0.0.1

# Set to false once your own account exists to stop anyone else from signing up.
# ALLOW_REGISTRATION=true

# 32 random bytes as base64. Encrypts bank access tokens in MongoDB. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATION_ENCRYPTION_KEY=

# Plaid (https://dashboard.plaid.com). The secret must match PLAID_ENV.
PLAID_CLIENT_ID=
PLAID_ENV=sandbox
PLAID_SANDBOX_SECRET=
# PLAID_PRODUCTION_SECRET=
# Only for banks that sign in through their own site (OAuth), like Citi. Must be https, end in
# /plaid-oauth, and be listed under "Allowed redirect URIs" in the Plaid dashboard
# (Developers > API). For local use, run an https tunnel to port 5173 (for example
# `ngrok http 5173`), put its address here, set CLIENT_ORIGIN to the same address's origin,
# then open Jackal through that address while linking.
# PLAID_REDIRECT_URI=https://your-name.ngrok-free.app/plaid-oauth
